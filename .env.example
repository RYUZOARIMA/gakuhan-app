# データベース（Postgres接続文字列）
# Vercel PostgresをStorageタブで作成しプロジェクトにConnectすると、
# 本番環境にはPOSTGRES_URLが自動で設定される。ローカル開発用にはDATABASE_URLを使う。
DATABASE_URL="postgres://user:password@host:5432/dbname"

# 注文通知メールの送信元SMTP設定
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="学販システム <no-reply@example.com>"

# 注文通知を受け取るメールアドレス（複数はカンマ区切り）
ORDER_NOTIFY_TO=""

# 管理画面（/admin）のログインパスワード
ADMIN_PASSWORD=""
